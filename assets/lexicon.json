{
  "_comment": "口癖词典 — 番 3 用预定义的 ~30 个候选模式，按频次排前 5",

  "patterns": [
    { "label": "还是…",          "regex": ["还是"], "examples": ["还是不像", "还是太幼稚化", "还是会卡顿"] },
    { "label": "我觉得…",         "regex": ["我觉得", "我感觉", "我认为"], "examples": ["我觉得是不是方案 B 最好"] },
    { "label": "怎么 / 能不能…",   "regex": ["怎么", "能不能", "能否"], "examples": ["怎么这么慢", "你怎么每次都犯这个错"] },
    { "label": "不好 / 不对",     "regex": ["^不好", "不好[，。!?]", "^不对", "不对[，。!?]"], "examples": ["不好", "不对，要类似 manus 这种"] },
    { "label": "太…了",           "regex": ["太[\\u4e00-\\u9fa5]{1,4}了"], "examples": ["太抢眼了", "太重了"] },
    { "label": "重做 / 重来 / 重新", "regex": ["重做", "重来", "重新"], "examples": ["重新部署吧"] },
    { "label": "为什么…",         "regex": ["为什么", "凭什么"], "examples": ["为什么不能直接"] },
    { "label": "是不是…",         "regex": ["是不是"], "examples": ["是不是有 bug"] },
    { "label": "你怎么…",          "regex": ["你怎么"], "examples": ["你怎么每次都犯这个错"] },
    { "label": "可以吗 / 行不行",   "regex": ["可以吗", "行不行", "能用吗"], "examples": ["这样可以吗"] },
    { "label": "再来一次",         "regex": ["再来一次", "再试一次", "再来一遍"], "examples": ["再来一次"] },
    { "label": "算了",            "regex": ["^算了", "算了[，。!?]"], "examples": ["算了不用了"] },
    { "label": "不行",            "regex": ["^不行", "不行[，。!?]"], "examples": ["不行，再来"] },
    { "label": "AI 味",           "regex": ["AI 味", "AI味"], "examples": ["这句太 AI 味"] },
    { "label": "不要 / 不需要",    "regex": ["^不要", "不需要"], "examples": ["不要加 emoji"] },
    { "label": "对了",            "regex": ["^对了", "对了[，。]"], "examples": ["对了，再补充一个"] },
    { "label": "继续",            "regex": ["^继续"], "examples": ["继续"] },
    { "label": "换 / 换一个",     "regex": ["^换一个", "换个", "换种"], "examples": ["换一个方案"] },
    { "label": "再…一点",         "regex": ["再[\\u4e00-\\u9fa5]{0,2}一点", "再[\\u4e00-\\u9fa5]+一些"], "examples": ["再克制一点"] },
    { "label": "我想…",           "regex": ["^我想"], "examples": ["我想要这种感觉"] }
  ],

  "praise_words": ["非常准确", "完美", "可以", "好的", "牛", "👍", "厉害"],

  "negation_words_for_calm_axis": [
    "还是", "不对", "不好", "重做", "重来", "重新",
    "怎么", "为什么", "到底", "算了", "不行", "差点意思",
    "没啥", "不咋", "不太行", "不太对", "再来"
  ],

  "drama_emoji": ["😅", "😂", "😭", "🙄", "🤔", "...", "??", "！？", "？？"],

  "naming_keywords": ["叫", "命名", "名字"],

  "_naming_regex_hint": "命名时刻匹配：'叫.{1,8}吧' / '命名为.{1,8}' / '我们就叫.{1,8}'"
}
